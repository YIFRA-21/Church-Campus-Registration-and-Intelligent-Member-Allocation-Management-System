datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Campus {
  id          String       @id @default(uuid())
  code        String       @unique
  name        String
  city        String
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  departments Department[]
  members     Member[]
  users       User[]
  batches     AllocationBatch[]
  imports     ImportBatch[]
  auditLogs   AuditLog[]
}

model User {
  id             String       @id @default(uuid())
  campusId       String?
  campus         Campus?      @relation(fields: [campusId], references: [id])
  departmentId   String?
  department     Department?  @relation(fields: [departmentId], references: [id])
  email          String       @unique
  passwordHash   String
  fullName       String
  role           String       @default("CAMPUS_ADMIN") // SUPER_ADMIN, CAMPUS_ADMIN, REGISTRATION_OFFICER, DEPT_MANAGER, EVALUATOR
  active         Boolean      @default(true)
  customPerms    String?      // JSON array of specific capability overrides
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  batchesCreated AllocationBatch[] @relation("BatchCreator")
  batchesApproved AllocationBatch[] @relation("BatchApprover")
  transfersRequested DepartmentTransferRequest[] @relation("TransferRequester")
  transfersApproved  DepartmentTransferRequest[] @relation("TransferApprover")
  auditLogs      AuditLog[]

  @@index([campusId])
  @@index([email])
}

model Department {
  id               String                    @id @default(uuid())
  campusId         String
  campus           Campus                    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  name             String
  code             String
  description      String?
  targetPercent    Float                     @default(0.0) // p_d (e.g. 0.25 = 25%)
  maxCapacity      Int                       @default(100) // M_d fixed hard limit
  priority         Int                       @default(1)   // Conflict-resolution priority (1 = highest)
  status           String                    @default("ACTIVE") // ACTIVE, DRAFT, INACTIVE, ARCHIVED
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  eligibilityRules DepartmentEligibilityRule[]
  balancingRules   DepartmentBalancingRule[]
  allocations      MemberAllocation[]
  proposals        AllocationProposal[]
  transfersFrom    DepartmentTransferRequest[] @relation("FromDept")
  transfersTo      DepartmentTransferRequest[] @relation("ToDept")
  managers         User[]

  @@unique([campusId, code])
  @@index([campusId, status])
}

model DepartmentEligibilityRule {
  id               String     @id @default(uuid())
  departmentId     String
  department       Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  allowedGenders   String     @default("ALL") // "ALL", "MALE", "FEMALE"
  allowedCategories String    @default("ALL") // JSON array ["Youth", "Adult"] or "ALL"
  requiresDeacon   Boolean?   // true = deacon only, false = non-deacon, null = any
  customPredicates String?    // JSON for extensible rules
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([departmentId])
}

model DepartmentBalancingRule {
  id                String     @id @default(uuid())
  departmentId      String
  department        Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  constraintType    String     @default("SOFT") // "HARD" (mandatory) or "SOFT" (scoring optimization)
  targetMaleRatio   Float?     // e.g. 0.50
  targetFemaleRatio Float?     // e.g. 0.50
  minCategoryQuota  String?    // JSON e.g. {"Youth": 10}
  maxCategoryQuota  String?    // JSON e.g. {"Elder": 5}
  deaconQuota       Int?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([departmentId])
}

model Member {
  id              String             @id @default(uuid())
  campusId        String
  campus          Campus             @relation(fields: [campusId], references: [id], onDelete: Cascade)
  registrationNo  String             @unique
  fullName        String
  phoneNumber     String
  gender          String             // "MALE" or "FEMALE"
  category        String             // "Youth", "Adult", "Elder", "Student", etc.
  isDeacon        Boolean            @default(false)
  status          String             @default("ACTIVE") // "ACTIVE", "PENDING", "INACTIVE", "ARCHIVED"
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  allocations     MemberAllocation[]
  proposals       AllocationProposal[]
  exceptions      AllocationException[]
  transfers       DepartmentTransferRequest[]

  @@index([campusId, status])
  @@index([phoneNumber])
}

model MemberAllocation {
  id           String           @id @default(uuid())
  memberId     String
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department       @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  batchId      String?
  batch        AllocationBatch? @relation(fields: [batchId], references: [id])
  isActive     Boolean          @default(true)
  assignedAt   DateTime         @default(now())
  revokedAt    DateTime?
  assignedBy   String           // User ID
  reason       String           // "BATCH_ALLOCATION", "MANUAL_ASSIGNMENT", "TRANSFER", etc.

  @@index([memberId, isActive])
  @@index([departmentId, isActive])
}

model AllocationBatch {
  id               String               @id @default(uuid())
  campusId         String
  campus           Campus               @relation(fields: [campusId], references: [id], onDelete: Cascade)
  batchNumber      String               @unique
  status           String               @default("DRAFT") // DRAFT, PROCESSING, PREVIEW_READY, PENDING_APPROVAL, APPROVED, COMMITTED, REJECTED, CANCELLED
  calculationMeta  String?              // JSON: { E_d, p_d, T_d, M_d, totalPool, roundingPolicy, timestamp }
  createdByUserId  String
  creator          User                 @relation("BatchCreator", fields: [createdByUserId], references: [id])
  approvedByUserId String?
  approver         User?                @relation("BatchApprover", fields: [approvedByUserId], references: [id])
  approvalNotes    String?
  committedAt      DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  proposals        AllocationProposal[]
  exceptions       AllocationException[]
  allocations      MemberAllocation[]

  @@index([campusId, status])
}

model AllocationProposal {
  id           String          @id @default(uuid())
  batchId      String
  batch        AllocationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  reasonCode   String          // "TARGET_MATCH", "PRIORITY_TIE_BREAKER", "BALANCING_FIT"
  reasonDetail String
  status       String          @default("PROPOSED") // PROPOSED, COMMITTED, REJECTED, EXCLUDED

  @@index([batchId, departmentId])
  @@index([memberId])
}

model AllocationException {
  id              String          @id @default(uuid())
  batchId         String
  batch           AllocationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  memberId        String
  member          Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reasonCode      String          // "NO_ELIGIBLE_DEPARTMENT", "CAPACITY_FULL", "CONFLICT_UNRESOLVED"
  reasonDetail    String
  reviewed        Boolean         @default(false)
  adminDecision   String?         // "LEAVE_UNASSIGNED", "MANUAL_OVERRIDE", "RULE_UPDATE"
  resolutionNotes String?
  createdAt       DateTime        @default(now())

  @@index([batchId, reviewed])
}

model DepartmentTransferRequest {
  id              String     @id @default(uuid())
  memberId        String
  member          Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  fromDeptId      String
  fromDept        Department @relation("FromDept", fields: [fromDeptId], references: [id])
  toDeptId        String
  toDept          Department @relation("ToDept", fields: [toDeptId], references: [id])
  requestedBy     String
  requester       User       @relation("TransferRequester", fields: [requestedBy], references: [id])
  approvedBy      String?
  approver        User?      @relation("TransferApprover", fields: [approvedBy], references: [id])
  rejectionReason String?
  status          String     @default("PENDING") // PENDING, APPROVED, REJECTED
  reason          String
  createdAt       DateTime   @default(now())
  resolvedAt      DateTime?

  @@index([memberId, status])
  @@index([toDeptId, status])
}

model ImportBatch {
  id            String    @id @default(uuid())
  campusId      String
  campus        Campus    @relation(fields: [campusId], references: [id], onDelete: Cascade)
  fileName      String
  totalRows     Int       @default(0)
  validRows     Int       @default(0)
  duplicateRows Int       @default(0)
  rejectedRows  Int       @default(0)
  status        String    @default("PREVIEW") // PREVIEW, COMMITTED, REJECTED
  uploadedBy    String
  rawData       String?   // JSON representation of validated staging rows
  reconciliationSummary String? // JSON summary
  createdAt     DateTime  @default(now())

  @@index([campusId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  campusId   String?
  campus     Campus?  @relation(fields: [campusId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  action     String   // "MEMBER_REGISTERED", "ALLOCATION_COMMITTED", "TRANSFER_APPROVED", etc.
  entityType String   // "Member", "Department", "AllocationBatch", etc.
  entityId   String
  oldValues  String?  // JSON
  newValues  String?  // JSON
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([campusId, createdAt])
  @@index([entityType, entityId])
}

